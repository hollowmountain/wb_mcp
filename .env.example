# ─── Публичный адрес сервера ────────────────────────────────────────────────
# Должен быть https и резолвиться из интернета: Claude ходит сюда со своих серверов.
PUBLIC_URL=https://mcp-wb.example.com
PORT=3000
HOST=127.0.0.1

# ─── Wildberries ────────────────────────────────────────────────────────────
# Персональный токен с категориями «Вопросы и отзывы» и «Чат с покупателями».
# Создаётся в ЛК продавца → Настройки → Доступ к API. Живёт 180 дней.
WB_TOKEN=
# true — работать против песочницы feedbacks-api-sandbox.wildberries.ru (тестовый токен)
WB_SANDBOX=false

# ─── Кто может пользоваться коннектором ─────────────────────────────────────
# google | yandex | invite
IDENTITY_PROVIDER=google
# Домены корпоративной почты через запятую. Пусто = только ALLOWED_EMAILS.
ALLOWED_EMAIL_DOMAINS=harbez.com
# Дополнительные адреса-исключения через запятую
ALLOWED_EMAILS=
# Кому разрешено ОТПРАВЛЯТЬ ответы клиентам. Пусто = никому, кроме ADMIN_EMAILS.
RESPONDER_EMAILS=
# Администраторы: всегда responder + доступ к /admin
ADMIN_EMAILS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# ─── Служебное ──────────────────────────────────────────────────────────────
DB_PATH=./data/mcp-wb.db
# openssl rand -hex 32
SESSION_SECRET=
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
LOG_LEVEL=info

# ─── Только для docker-compose (Caddy + Let's Encrypt) ──────────────────────
# Домен, на который указывает A-запись сервера. Должен совпадать с PUBLIC_URL.
MCP_DOMAIN=mcp-wb.example.com
ACME_EMAIL=admin@example.com
