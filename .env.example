# ─── Публичный адрес сервера ────────────────────────────────────────────────
# Должен быть https и резолвиться из интернета: Claude ходит сюда со своих серверов.
PUBLIC_URL=https://mcp-wb.example.com
PORT=3000
HOST=127.0.0.1

# ─── Wildberries: кабинеты продавца ─────────────────────────────────────────
# Каждому кабинету нужен свой ПЕРСОНАЛЬНЫЙ токен с категориями
# «Вопросы и отзывы» + «Чат с покупателями» и уровнем доступа «Чтение и запись».
# Токен создаётся в ЛК продавца → Настройки → Доступ к API, живёт 180 дней.
#
# Идентификаторы кабинетов через запятую: строчные латинские буквы, цифры,
# дефис и подчёркивание. Именно их сотрудники будут указывать в Claude.
WB_CABINETS=main,opt
# Для каждого идентификатора — пара переменных. Суффикс = идентификатор
# в ВЕРХНЕМ регистре, дефисы заменены на подчёркивания.
WB_LABEL_MAIN=Основной кабинет
WB_TOKEN_MAIN=
WB_LABEL_OPT=Оптовый кабинет
WB_TOKEN_OPT=

# Разобрать пачку токенов и понять, какой к какому кабинету относится:
#   npx tsx scripts/inspect-tokens.ts tokens.txt --env

# Если кабинет один, можно обойтись без WB_CABINETS и задать просто:
# WB_TOKEN=

# true — работать против песочницы feedbacks-api-sandbox.wildberries.ru (тестовый токен)
WB_SANDBOX=false

# ─── Кто может пользоваться коннектором ─────────────────────────────────────
# google | yandex | invite
IDENTITY_PROVIDER=google
# Домены корпоративной почты через запятую. Пусто = только ALLOWED_EMAILS.
ALLOWED_EMAIL_DOMAINS=harbez.com
# Дополнительные адреса-исключения через запятую
ALLOWED_EMAILS=
# Кому разрешено ОТПРАВЛЯТЬ ответы клиентам. Пусто = никому, кроме ADMIN_EMAILS.
RESPONDER_EMAILS=
# Администраторы: всегда responder + доступ к /admin
ADMIN_EMAILS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# ─── Служебное ──────────────────────────────────────────────────────────────
DB_PATH=./data/mcp-wb.db
# openssl rand -hex 32
SESSION_SECRET=
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
LOG_LEVEL=info

# ─── Только для docker-compose (Caddy + Let's Encrypt) ──────────────────────
# Домен, на который указывает A-запись сервера. Должен совпадать с PUBLIC_URL.
# Токен для чтения данных: заказы, карточки, цены, возвраты, статистика.
# Выпускается отдельно от WB_TOKEN_<SLUG> и должен быть «только на чтение»:
# признак read-only в токене WB один на весь токен, поэтому «отвечать можно,
# остальное только смотреть» выражается только парой токенов.
# Необязателен: без него кабинет работает как раньше, но wb_product и wb_returns
# по нему недоступны.
# WB_DATA_TOKEN_MAIN=eyJ...

MCP_DOMAIN=mcp-wb.example.com
ACME_EMAIL=admin@example.com

# --- Необязательное ---
# Хост (IP или домен), для которого Caddy проксирует /.well-known/acme-challenge/*
# на 127.0.0.1:8080. Нужен, только если на этой же машине живёт отдельный acme.sh,
# которому иначе не достаётся 80-й порт. Пусто — блок работает как заглушка.
VPN_ACME_HOST=

# --- Nepsell (необязательно) ---
# Аналитика маркетплейсов. Берём оттуда только то, чего нет у самих площадок:
# себестоимость и производную от неё экономику, рекламу в связке с продажами.
# Ключ создаётся в личном кабинете Nepsell, вид: nps_a1_...
# Пустой ключ — раздел выключен, инструменты не появляются ни у кого.
NEPSELL_TOKEN=
# Кому открыт Nepsell, через запятую. Там себестоимость и прибыль, поэтому
# список отдельный, а не роль. Администраторы видят всегда.
NEPSELL_EMAILS=

# --- 1С:УНФ (необязательно) ---
# Учётная система предприятия через стандартный интерфейс OData.
# Только чтение: в клиенте нет методов записи, а служебный пользователь
# в самой 1С работает под профилем «Только просмотр».
# Публикация OData в базе — грубый инструмент: разрешение зависимостей
# одного справочника транзитивно открывает почти всю конфигурацию,
# поэтому состав доступного сужен белым списком в src/onec/client.ts.
ONEC_BASE_URL=
ONEC_USER=
ONEC_PASSWORD=
# Кому открыта 1С, через запятую. Администраторы видят всегда.
ONEC_EMAILS=
