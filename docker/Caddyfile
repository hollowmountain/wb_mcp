{
	email {$ACME_EMAIL}
}

{$MCP_DOMAIN} {
	encode zstd gzip

	# Anthropic ходит на /mcp и на оба well-known-документа; остальное — страницы входа.
	reverse_proxy mcp-wb:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
		# Ответ на tools/call может ждать WB до минуты.
		transport http {
			read_timeout 120s
			write_timeout 120s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format json
	}
}

# Caddy держит 80-й порт, поэтому acme.sh на этом же хосте не может пройти
# http-01 валидацию для своего сертификата и молча перестаёт продлевать.
# Отдаём ему только путь валидации; acme.sh слушает 8080 на хосте.
# 172.18.0.1 — шлюз docker-сети проекта, то есть сам хост изнутри контейнера.
# Адрес берётся из VPN_ACME_HOST в .env; если не задан, подставится 127.0.0.1
# и блок станет безвредной заглушкой.
http://{$VPN_ACME_HOST} {
	handle /.well-known/acme-challenge/* {
		reverse_proxy 172.18.0.1:8080
	}
	handle {
		respond 404
	}
}
